{
	"ws": {
		"name": "MCWSLoader",
		"port": 8080,
		"connection": {
			"maxConnections": 100,
			"enableMaxConnections": false,
			"enableConnectionRateLimit": true,
			"rateLimitWindow": 60000,
			"rateLimitMax": 10,
			"perMessageDeflate": false,
			"maxPayload": 0
		},
		"checkDependenciesOnLoad": true
	},
	"command": {
		"maxLength": 461,
		"rateLimit": {
			"enabled": true,
			"windowMs": 50,
			"maxPerWindow": 1024
		}
	},
	"web": {
		"port": 50005,
		"auth": {
			"maxAttempts": 3,
			"windowMs": 60000,
			"lockoutMs": 60000
		}
	},
	"logLevel": "info",
	"commandPrefix": "$",
	"sapi": {
		"gmsg": "gmsg",
		"smsg": "smsg"
	},
	"utils": {
		"tellAllToTell": false,
		"enablePolling": true
	},
	"language": "zh-CN"
}
