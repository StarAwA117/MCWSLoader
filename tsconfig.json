{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2023"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": [
			"node"
		],
		"strict": true,
		"noEmit": true,
		"allowJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": true,
		"useUnknownInCatchVariables": true
	},
	"include": [
		"main.ts",
		"ws.ts",
		"lib/**/*",
		"web/server.ts",
		"lib/types/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"web/frontend",
		"mods",
		"resources",
		"tmp",
		"logs"
	]
}
